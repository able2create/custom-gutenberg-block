{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "tripolt-25/combo-03",
    "title": "3er Combo",
    "category": "widgets",
    "icon": "images-alt2",
    "description": "A custom block with a textarea and sortable images.",
    "keywords": ["combo", "images", "gallery", "text"],
    "version": "1.0.0",
    "textdomain": "tripolt-25",
    "attributes": {
        "content": {
            "type": "string",
            "source": "html",
            "selector": "p"
        },
        "images": {
            "type": "array",
            "default": [],
            "items": {
                "type": "object",
                "properties": {
                    "id": { "type": "number" },
                    "url": { "type": "string" },
                    "alt": { "type": "string" }
                }
            }
        }
    },
    "supports": {
        "html": false,
        "align": true,
        "spacing": {
            "margin": true,
            "padding": true
        }
    },
    "editorScript": "file:./index.js",
    "editorStyle": "file:./editor.css",
    "style": "file:./style.css"
}